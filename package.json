{
  "name": "df-commandes",
  "version": "1.4.2",
  "private": true,
  "description": "API de devis et de commandes de Delmas & Fournier, maintenue par Néotis",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "test:couverture": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-include=src/**",
    "test:caracterisation": "node --disable-warning=ExperimentalWarning --test test/caracterisation/*.test.js",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench-export.js",
    "lint": "eslint .",
    "start:local": "node --disable-warning=ExperimentalWarning --env-file=.env src/server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  }
}
